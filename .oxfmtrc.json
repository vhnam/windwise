{
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "ignorePatterns": ["**/routeTree.gen.ts", "./.claude/**", "./.changeset/**"],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,js,jsx}"],
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": ["**/*.{md,mdx}"],
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    },
    {
      "files": ["apps/**"],
      "options": {
        "sortImports": {
          "customGroups": [
            {
              "groupName": "css-url",
              "elementNamePattern": ["@windwise/ui"]
            },
            {
              "groupName": "side_effect_style",
              "selector": "side_effect_style"
            },
            {
              "groupName": "windwise",
              "elementNamePattern": [
                "@windwise/query",
                "@windwise/query/**",
                "@windwise/ui/**",
                "@windwise/schemas",
                "@windwise/schemas/**",
                "@windwise/core",
                "@windwise/core/**",
                "@windwise/db",
                "@windwise/db/**",
                "@windwise/ai",
                "@windwise/ai/**",
                "@windwise/vite-config",
                "@windwise/vite-config/**"
              ]
            },
            {
              "groupName": "app",
              "elementNamePattern": ["#/**"]
            }
          ],
          "newlinesBetween": true,
          "groups": [
            "builtin",
            "external",
            "windwise",
            "app",
            "css-url",
            ["style", "side_effect_style"],
            ["parent", "sibling", "index"],
            "unknown"
          ]
        }
      }
    }
  ],
  "sortImports": {
    "customGroups": [
      {
        "groupName": "css-url",
        "elementNamePattern": ["@windwise/ui"]
      },
      {
        "groupName": "side_effect_style",
        "selector": "side_effect_style"
      },
      {
        "groupName": "windwise",
        "elementNamePattern": [
          "@windwise/query",
          "@windwise/query/**",
          "@windwise/ui/**",
          "@windwise/schemas",
          "@windwise/schemas/**",
          "@windwise/core",
          "@windwise/core/**",
          "@windwise/db",
          "@windwise/db/**",
          "@windwise/ai",
          "@windwise/ai/**",
          "@windwise/vite-config",
          "@windwise/vite-config/**"
        ]
      },
      {
        "groupName": "app",
        "elementNamePattern": ["#/**"]
      }
    ],
    "newlinesBetween": true,
    "groups": [
      "builtin",
      "external",
      "windwise",
      "app",
      "css-url",
      ["style", "side_effect_style"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
