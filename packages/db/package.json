{
  "name": "@windwise/db",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "vp exec node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types src/seed-cli.ts",
    "db:check-sources": "vp exec node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types src/jobs/check-source-liveness-cli.ts"
  },
  "dependencies": {
    "@t3-oss/env-core": "catalog:",
    "@windwise/schemas": "workspace:*",
    "better-auth": "^1.6.29",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
